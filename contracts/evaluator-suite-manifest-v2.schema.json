{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rubrist.dev/contracts/evaluator-suite-manifest-v2.schema.json",
  "title": "Rubrist evaluator suite manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "manifestId",
    "suiteId",
    "projectId",
    "revision",
    "members",
    "trialPlan",
    "manifestDigest"
  ],
  "properties": {
    "contract": {
      "const": "rubrist/evaluator-suite-manifest/v2"
    },
    "schemaVersion": {
      "const": 2
    },
    "manifestId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "suiteId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "projectId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/member"
      }
    },
    "trialPlan": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/trialPlan"
        }
      ]
    },
    "manifestDigest": {
      "$ref": "#/$defs/sha256Digest"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "all_items"
        }
      }
    },
    "trialPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "trialsPerItem"
      ],
      "properties": {
        "kind": {
          "const": "independent_repetitions"
        },
        "trialsPerItem": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "criterionId",
        "criterionVersionId",
        "criterionName",
        "criterionDefinition",
        "criterionDigest",
        "skillId",
        "skillVersionId",
        "skillDigest",
        "outputContractDigest",
        "applicability"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "criterionId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "criterionVersionId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "criterionName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "criterionDefinition": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "criterionDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "skillId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "skillVersionId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "skillDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "outputContractDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        }
      }
    }
  }
}
