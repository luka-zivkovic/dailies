{
  "name": "dailies",
  "version": "0.2.0",
  "description": "Scope-bound, trust-aware release decisions for AI changes: promote, block, or inconclusive.",
  "license": "MIT",
  "author": "Luka Živković",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dailies": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "keywords": [
    "ai",
    "evaluation",
    "release-gate",
    "llm",
    "ci"
  ],
  "scripts": {
    "benchmark:batch3": "npm run build --silent && node scripts/benchmark-batch3.mjs",
    "build": "tsc",
    "invariant:batch6": "npm run build --silent && node scripts/invariant-robustness.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ajv": "^8.20.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luka-zivkovic/dailies.git"
  },
  "homepage": "https://github.com/luka-zivkovic/dailies#readme",
  "bugs": {
    "url": "https://github.com/luka-zivkovic/dailies/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
